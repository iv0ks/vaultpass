# Copy to .env for local runs. docker compose reads this file.

# --- Postgres (the `postgres` service) ---
POSTGRES_USER=vaultpass
POSTGRES_PASSWORD=vaultpass
POSTGRES_DB=vaultpass

# --- App ---
# Inside the compose network the DB host is the service name `postgres`.
DATABASE_URL=postgres://vaultpass:vaultpass@postgres:5432/vaultpass
# Secret that signs the HS256 access tokens issued at login.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
PORT=3000

# --- Traefik ACME (DNS-01 via Namecheap). Only needed if you use Traefik. ---
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=

# Root path for the Traefik config bind mount (defaults to repo root).
# ROOT_PATH=.
